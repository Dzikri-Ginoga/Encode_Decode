{
  "$schema": "https://schemas.tokens.dtcg.org/v1/tokens.schema.json",
  "$description": "KriptoHengker tokens. Tier 1 primitif, tier 2 semantik, tier 3 komponen. Sumber kebenaran, css/tokens.css adalah hasil flatten.",
  "color": {
    "paper": { "$value": "#F5F5F5", "$type": "color" },
    "white": { "$value": "#FFFFFF", "$type": "color" },
    "black": { "$value": "#171717", "$type": "color" },
    "gray-700": { "$value": "#404040", "$type": "color" },
    "gray-500": { "$value": "#737373", "$type": "color" },
    "gray-400": { "$value": "#A3A3A3", "$type": "color" },
    "gray-200": { "$value": "#E5E5E5", "$type": "color" },
    "gray-300": { "$value": "#D4D4D4", "$type": "color" },
    "surface-page": { "$value": "{color.paper}", "$type": "color" },
    "surface-card": { "$value": "{color.white}", "$type": "color" },
    "text-strong": { "$value": "{color.black}", "$type": "color" },
    "text-body": { "$value": "{color.gray-700}", "$type": "color" },
    "text-muted": { "$value": "{color.gray-500}", "$type": "color" },
    "text-faint": { "$value": "{color.gray-400}", "$type": "color" },
    "border-line": { "$value": "{color.gray-200}", "$type": "color" },
    "border-dark": { "$value": "{color.gray-300}", "$type": "color" },
    "action-primary": { "$value": "{color.black}", "$type": "color" },
    "action-accent": { "$value": "{color.black}", "$type": "color" },
    "action-accent-wash": { "$value": "{color.paper}", "$type": "color" },
    "mark-tap": { "$value": "{color.black}", "$type": "color" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "gutter": { "$value": "{space.4}", "$description": "Margin horizontal konten" },
    "section-gap": { "$value": "{space.5}", "$description": "Jarak antar kartu" },
    "component-gap": { "$value": "{space.2}", "$description": "Jarak dalam komponen" }
  },
  "font": {
    "family": {
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"], "$type": "fontFamily" },
      "mono": { "$value": ["JetBrains Mono", "Consolas", "monospace"], "$type": "fontFamily" }
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "28px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.02em" }
    },
    "title": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "17px", "fontWeight": 700, "lineHeight": 1.35, "letterSpacing": "-0.01em" }
    },
    "body": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.65, "letterSpacing": "0em" }
    },
    "label": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "11px", "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "0.07em" }
    },
    "mono": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.mono}", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.6, "letterSpacing": "0em" }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "full": { "$value": "9999px" }
  },
  "card": {
    "padding": { "$value": "{space.5}", "$type": "dimension" },
    "gap": { "$value": "{space.5}", "$type": "dimension" },
    "radius": { "$value": "{radius.md}", "$type": "dimension" },
    "border": { "$value": "{color.border-line}", "$type": "color" }
  },
  "button": {
    "radius": { "$value": "{radius.sm}", "$type": "dimension" },
    "padding-y": { "$value": "{space.2}", "$type": "dimension" },
    "padding-x": { "$value": "{space.4}", "$type": "dimension" }
  }
}
