{
  "$schema": "https://schemas.tokens.dtcg.org/v1/tokens.schema.json",
  "$description": "KriptoHengker tokens. Tier 1 primitif, tier 2 semantik, tier 3 komponen. Sumber kebenaran, css/tokens.css adalah hasil flatten.",
  "color": {
    "cream": { "$value": "#FAF6EF", "$type": "color" },
    "white": { "$value": "#FFFFFF", "$type": "color" },
    "ink": { "$value": "#1C1917", "$type": "color" },
    "ink-soft": { "$value": "#44403C", "$type": "color" },
    "muted": { "$value": "#78716C", "$type": "color" },
    "faint": { "$value": "#A8A29E", "$type": "color" },
    "line": { "$value": "#E7E0D3", "$type": "color" },
    "line-dark": { "$value": "#D6CDB8", "$type": "color" },
    "teal": { "$value": "#0F766E", "$type": "color" },
    "teal-wash": { "$value": "#EDF7F5", "$type": "color" },
    "amber": { "$value": "#B45309", "$type": "color" },
    "surface-page": { "$value": "{color.cream}", "$type": "color" },
    "surface-card": { "$value": "{color.white}", "$type": "color" },
    "text-strong": { "$value": "{color.ink}", "$type": "color" },
    "text-body": { "$value": "{color.ink-soft}", "$type": "color" },
    "text-muted": { "$value": "{color.muted}", "$type": "color" },
    "text-faint": { "$value": "{color.faint}", "$type": "color" },
    "border-line": { "$value": "{color.line}", "$type": "color" },
    "action-primary": { "$value": "{color.ink}", "$type": "color" },
    "action-accent": { "$value": "{color.teal}", "$type": "color" },
    "action-accent-wash": { "$value": "{color.teal-wash}", "$type": "color" },
    "mark-tap": { "$value": "{color.amber}", "$type": "color" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "gutter": { "$value": "{space.4}", "$description": "Margin horizontal konten" },
    "section-gap": { "$value": "{space.5}", "$description": "Jarak antar kartu" },
    "component-gap": { "$value": "{space.2}", "$description": "Jarak dalam komponen" }
  },
  "font": {
    "family": {
      "serif": { "$value": ["Source Serif 4", "Georgia", "serif"], "$type": "fontFamily" },
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"], "$type": "fontFamily" },
      "mono": { "$value": ["JetBrains Mono", "Consolas", "monospace"], "$type": "fontFamily" }
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.serif}", "fontSize": "30px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.01em" }
    },
    "title": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.serif}", "fontSize": "20px", "fontWeight": 700, "lineHeight": 1.3, "letterSpacing": "0em" }
    },
    "body": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.65, "letterSpacing": "0em" }
    },
    "label": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "11px", "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "0.07em" }
    },
    "mono": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.mono}", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.6, "letterSpacing": "0em" }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "full": { "$value": "9999px" }
  },
  "card": {
    "padding": { "$value": "{space.5}", "$type": "dimension" },
    "gap": { "$value": "{space.5}", "$type": "dimension" },
    "radius": { "$value": "{radius.md}", "$type": "dimension" },
    "border": { "$value": "{color.border-line}", "$type": "color" }
  },
  "button": {
    "radius": { "$value": "{radius.sm}", "$type": "dimension" },
    "padding-y": { "$value": "{space.2}", "$type": "dimension" },
    "padding-x": { "$value": "{space.4}", "$type": "dimension" }
  }
}
